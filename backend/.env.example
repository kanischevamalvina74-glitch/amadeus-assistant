# Все значения задаёт пользователь. Файл .env окружения не коммитится.

# Обязательно для релиза: ключ шифрования БД (SQLCipher).
# Для локальной разработки можно явно разрешить незашифрованную БД.
# НЕ оставляйте эту строку включённой в продакшене.
# AMADEUS_ALLOW_PLAINTEXT_DB=1
# AMADEUS_DB_KEY=задайте_свой_ключ

AMADEUS_DB_PATH=./data/amadeus.db
AMADEUS_SECRET_STORE=keyring

# Локальный публичный API Ollama, официальный эндпоинт /api/chat.
AMADEUS_OLLAMA_URL=http://127.0.0.1:11434
AMADEUS_OLLAMA_MODEL=hf.co/nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB:Q4_K_M

# Белый список хостов облачных провайдеров через запятую (SSRF-защита).
# Пусто = проверка чужих ключей недоступна; локальный режим работает без сети.
AMADEUS_PROVIDER_ALLOWLIST=

# Только для тестов изоляции пользователей. В проде оставить выключенным.
AMADEUS_ALLOW_USER_OVERRIDE=0
AMADEUS_LOG_LEVEL=INFO

# Запуск:
# python -m uvicorn core.app:app --app-dir replica/backend --host 127.0.0.1 --port 8787
