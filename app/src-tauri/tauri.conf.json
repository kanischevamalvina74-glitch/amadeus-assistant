{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amadeus",
  "version": "0.1.0",
  "identifier": "com.amadeus.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Amadeus",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787 ws://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Amadeus",
    "copyright": "Copyright © 2026 Amadeus",
    "licenseFile": "../../LICENSE",
    "externalBin": ["../../backend/dist/amadeus-core"],
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "customLanguageFiles": { "Russian": "nsis/Russian.nsh" },
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
